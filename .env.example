# ==========================================
# Supabase Configuration (LOCAL)
# ==========================================

# Supabase URL for internal container communication
# If using host.docker.internal is failing with IPv6 errors, use container names
SUPABASE_URL=http://kong:8000

# Supabase Keys (In local dev, these can be any string)
SUPABASE_ANON_KEY=ANON_KEY

# JWT Configuration
# Use the internal Kong alias on port 8000
SUPABASE_JWKS_URL=http://kong:8000/auth/v1/.well-known/jwks.json

# Database Configuration
# Use the internal db alias on port 5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres

# ==========================================
# Application Configuration
# ==========================================
API_PORT=8080
LOG_LEVEL=debug
WORKER_CONCURRENCY=5

# ==========================================
# External Services
# ==========================================
MOCK_BANK_URL=http://mock-bank:8081/validate
BACKEND_WEBHOOK_URL=http://api:8080/webhook/bank-update


